{
  "name": "samurai-launcher",
  "productName": "Samurai Client",
  "version": "0.1.0",
  "description": "Launcher for Samurai Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.1",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "gg.samurai.client",
    "productName": "Samurai Client",
    "files": [
      "**/*",
      "bundled/**/*"
    ],
    "win": {
      "target": "portable",
      "artifactName": "SamuraiClient.exe"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "output": "dist"
    }
  }
}